# ---- Public site ----
# Public origin. Must be HTTPS in production: iOS only installs over HTTPS.
PUBLIC_BASE_URL=https://iramzipa.com
# Canonical domain. www.<domain> redirects here. Change when the domain is connected.
PRIMARY_DOMAIN=iramzipa.com

# ---- Storage ----
# Private directory for IPA files, signed IPAs, certificates and the SQLite DB.
DATA_DIR=./data
MAX_UPLOAD_MB=500

# ---- Admin ----
ADMIN_EMAIL=you@example.com
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Optional but strongly recommended (MFA). Base32 secret for an authenticator app.
ADMIN_TOTP_SECRET=
# Random 32+ bytes: openssl rand -base64 48
SESSION_SECRET=
# Encrypts certificates and provisioning profiles at rest. 32 bytes base64: openssl rand -base64 32
CERT_ENCRYPTION_KEY=

# ---- Signing ----
# Path to a zsign binary (see scripts/build-zsign.sh). Empty = signing disabled.
ZSIGN_BIN=
